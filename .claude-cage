-- Test config for claude-cage-git
claude_cage {
    user = "test-cage-user",
    project = "test-project",
    showBanner = true,
    -- mode = "bwrap",  -- or "docker"
    autoMerge = true,  -- auto-merge pushes from cage to source
    networkMode = "allowlist",

    -- Gitignore-style exclude patterns
    exclude = {
        "**/.env",
        "**/node_modules",
        "secrets/**",
    },

    allow = {
        domains = { "github.com:443", "api.anthropic.com:443" },
    },

    -- Additional mounts into the sandbox
    additionalMounts = {
        "~/.claude",
        "~/.claude.json",
        { source = "~/.config/claude-cage/claude-settings.json", as = "~/.claude/settings.json" },
    },
}
