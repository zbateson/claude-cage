-- Example .claude-cage configuration
--
-- Place this file as .claude-cage at your project's git root.
--
-- Config files are loaded and merged in order:
--   1. /etc/claude-cage.conf          (system-wide defaults)
--   2. ~/.config/claude-cage/config   (user preferences)
--   3. includeIf matches              (directory-scoped configs, set in system/user)
--   4. .claude-cage                    (project settings, at git root)
--
-- Array options (exclude, carry, allow, block, additionalMounts, docker.packages) merge across levels.
-- Scalar options are overridden by later configs.
--
-- See examples/example-user-config for includeIf usage.

claude_cage {
    -- =========================================================================
    -- LAUNCH COMMAND
    -- =========================================================================
    -- What to run inside the sandbox. Defaults to "claude".
    -- Can be any command: "aider", "cursor", a custom script, etc.

    launch = "claude",

    -- =========================================================================
    -- FILE EXCLUSION
    -- =========================================================================
    -- Files matching these patterns are excluded during fast-export.
    -- They never enter the cage - not in files, not in git history.

    exclude = {
        ".env",
        ".env.*",
        "*.pem",
        "*.key",
        "secrets/**",
        "config/production.yml",
        "application-*.properties",
    },

    -- =========================================================================
    -- CARRY FILES (copied source→work at startup, deposited to .caged on exit)
    -- =========================================================================
    -- Files listed here are copied source→work at startup, outside git, so
    -- gitignored files like CLAUDE.md or .cursorrules end up in the cage.
    --
    -- On exit the cage hashes each carry file against a startup snapshot:
    --   - Unchanged in the cage  → silently skipped (announced so you know).
    --   - Changed in the cage    → deposited at
    --     <git-root>/.caged/carry/<session>/<src-path>, never back onto
    --     source. Multiple sessions writing to source would collide; the
    --     deposit is the unambiguous user-visible record.
    --
    -- Requires createCagedDir = true for deposits to land somewhere. Without
    -- it, you'll get a heads-up at startup and a warning on exit naming the
    -- carry files whose edits couldn't be saved.
    --
    -- Git-tracked files are skipped automatically (git handles those), so
    -- you can set carry globally: repos that commit the file use git, repos
    -- that gitignore it use carry.

    -- carry = { "CLAUDE.md", ".cursorrules", ".claude/settings.json" },

    -- =========================================================================
    -- SANDBOX MODE
    -- =========================================================================
    -- "bwrap" (default) - Uses bubblewrap for namespace isolation
    --   Requires: bubblewrap, slirp4netns (for network filtering)
    --   Platform: Linux, Windows (WSL 2)
    --
    -- "docker" - Uses Docker container
    --   Requires: Docker
    --   Platform: Linux, macOS, Windows (WSL 2)

    mode = "bwrap",

    -- Docker options (only used when mode = "docker")
    -- docker = {
    --     image = "node:lts-slim",
    --     packages = { "curl", "iputils-ping" },  -- installed as root before dropping privileges
    -- },

    -- =========================================================================
    -- SYNC OPTIONS
    -- =========================================================================
    -- Auto-sync pushes Claude's commits on non-active branches back to your
    -- source repo in real-time (via temp-index, no checkout needed).
    -- Your active branch is untouched unless syncActiveBranch is also enabled.
    -- Without autoSync, ALL branches need manual "claude-cage git-merge".

    autoSync = true,

    -- EXPERIMENTAL: Also sync commits to the branch you're actively on.
    -- Stashes your work, applies Claude's changes, then pops the stash.
    -- Best on a dedicated branch. Can cause conflicts on shared ones.
    -- syncActiveBranch = false,

    -- Copy uncommitted source files (modifications, untracked, deletes) into
    -- the cage at startup. Default is off, so the cage starts from your last
    -- committed state. Pass --with-dirty for a one-off; set true here to make
    -- it the default. Independent of syncActiveBranch.
    -- bringDirty = false,

    -- Allow running in non-git directories. When true, directories without
    -- a git repo are mounted directly (no sync, changes go straight to source).
    -- When false, claude-cage requires a git repo. When unset, prompts.
    -- allowNonGit = true,

    -- Direct mount mode - mount source directly without git clone/sync.
    -- Use this when you want a simple sandbox without the git machinery,
    -- even when working in a git repo. Changes go straight to source.
    -- directMount = false,

    -- Route this project to its own sealed 'isolated' session instead of the
    -- shared 'default'. The isolated session never mounts default's work tree,
    -- and other projects in default never see this one. Use this either way
    -- the leak risk runs:
    --   - Mostly-public projects + one or two with secrets in default:
    --     mark the public ones as 'isolated' so the OSS cage never sees the
    --     secrets project's tree.
    --   - One sealed-off private project + others in default: mark the
    --     private project as 'isolated' so other cages can't read it.
    -- Sticky: once the isolated cache exists, claude-cage keeps using it
    -- even if 'isolated = true' is removed from this file. Run
    -- 'claude-cage clean isolated' to truly opt back into default.
    -- isolated = false,

    -- =========================================================================
    -- BWRAP SANDBOX MOUNTS & MASKS
    -- =========================================================================
    -- System directories mounted read-only and sensitive paths masked in bwrap
    -- mode. Docker mode doesn't need this — the container image provides its
    -- own isolated filesystem.
    --
    -- Dirs in maskPaths get an empty tmpfs overlay; files get /dev/null.
    -- Arrays merge across config levels (system + user + project).

    bwrap = {
        systemMounts = { "/etc", "/usr", "/bin", "/lib", "/lib64", "/sbin" },
        maskPaths = {
            "/etc/shadow", "/etc/gshadow", "/etc/sudoers", "/etc/sudoers.d",
            "/etc/ssl/private", "/etc/pki/tls/private", "/etc/pki/nssdb",
            "/etc/letsencrypt", "/etc/security",
            "/etc/openvpn", "/etc/wireguard", "/etc/ipsec.d", "/etc/ipsec.secrets",
            "/etc/NetworkManager/system-connections", "/etc/wpa_supplicant", "/etc/ppp",
            "/etc/docker", "/etc/samba", "/etc/krb5.keytab", "/etc/machine-id",
        },
    },

    -- =========================================================================
    -- ADDITIONAL MOUNTS
    -- =========================================================================
    -- Extra read-only mounts for the sandbox. Useful for config files
    -- that Claude needs but aren't in your project.

    additionalMounts = {
        "~/.local/bin/claude",
        { source = "~/.claude", mode = "rw" },
        { source = "~/.claude.json", mode = "rw" },
        "~/.gitconfig",
        "~/.bashrc",
        "~/.profile",
        "~/Projects/public/.gitconfig",
        { source = "~/.config/claude-cage/claude-settings.json", as = "~/.claude/settings.json" },
    },

    -- =========================================================================
    -- NETWORK FILTERING
    -- =========================================================================
    -- Control what network destinations Claude can reach.
    --
    -- "disabled" (default) - No filtering, full network access
    -- "allowlist" - Block everything except specified destinations
    -- "blocklist" - Allow everything except specified destinations

    networkMode = "disabled",

    -- Allowlist example: only allow specific services
    -- networkMode = "allowlist",
    -- allow = {
    --     domains = {
    --         "github.com:443",
    --         "api.anthropic.com:443",
    --         "registry.npmjs.org:443",
    --     },
    --     ips = { "8.8.8.8:53" },
    --     networks = { "10.0.0.0/8" },
    -- },

    -- Blocklist example: block internal infrastructure
    -- networkMode = "blocklist",
    -- block = {
    --     domains = { "internal.company.com" },
    --     ips = { "169.254.169.254" },  -- AWS metadata endpoint
    --     networks = { "192.168.0.0/16" },
    -- },

    -- =========================================================================
    -- GIT OPTIONS
    -- =========================================================================

    -- git = {
    --     historyDepth = 50,       -- First-parent depth on default branch (default: 50)
    --     defaultBranch = "auto",  -- Branch for history anchoring: "auto" or explicit name
    --     scoped = false,          -- Scope intermediary to CWD subdirectory (same as --scoped)
    --     blockForceAdd = true,    -- Block commits with force-added gitignored files
    -- },

    -- =========================================================================
    -- DISPLAY & CONVENIENCE
    -- =========================================================================

    -- Show the ASCII art banner on startup
    showBanner = true,

    -- Skip the "press any key" confirmation prompt before entering sandbox
    -- hideConfirmationPrompt = false,

    -- Create .caged/ directory with symlinks to cache directories.
    -- Gives you easy access to work/ and intermediary/ for each session.
    -- createCagedDir = false,
}
