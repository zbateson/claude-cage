-- Test config for claude-cage-git
claude_cage {
    user = "test-cage-user",
    project = "test-project",
    showBanner = true,
    isolationMode = "bwrap",
    networkMode = "allowlist",

    exclude = {
        name = { ".env", "node_modules", ".git" },
        path = { "secrets/credentials.json" },
    },

    allow = {
        domains = { "github.com:443", "api.anthropic.com:443" },
    },

    homeConfigSync = {
        ".gitconfig",
        { path = ".claude", mode = "sync" },
    },
}
